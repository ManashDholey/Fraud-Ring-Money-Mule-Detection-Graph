# Production Environment Configuration for Railway.app
# 
# IMPORTANT: Do NOT commit this file to git with real credentials
# Instead, set these variables in the Railway.app dashboard
#
# How to use:
# 1. Copy this file to .env.production
# 2. Replace placeholder values with actual production credentials
# 3. In Railway.app dashboard: Backend Service → Variables tab → Set each variable
# 4. In Railway.app dashboard: Frontend Service → Variables tab → Set VITE_API_URL
# 5. DO NOT commit .env.production to git
#
# Railway.app will automatically provide:
# - PORT (dynamically assigned)
# - RAILWAY_ENVIRONMENT_NAME
# - RAILWAY_STATIC_URL (optional CDN)

# ===========================================================================
# DATABASE CONFIGURATION (from CognoDB / Neo4j managed service)
# ===========================================================================
COGNODB_URI=bolt+s://your-cogno-host.cogno.db:7687
COGNODB_USERNAME=neo4j
COGNODB_PASSWORD=your_ultra_secure_password_here

# ===========================================================================
# BACKEND API CONFIGURATION
# ===========================================================================
# Replace with your LIVE Railway.app frontend domain
CORS_ORIGINS=https://your-project-frontend.railway.app,https://your-custom-domain.com

# Enable auto-seeding on first deploy (set to false after initial seeding)
AUTO_SEED_ON_STARTUP=true

# ===========================================================================
# FRONTEND CONFIGURATION
# ===========================================================================
# Replace with your LIVE Railway.app backend domain
VITE_API_URL=https://your-project-backend.railway.app/api

# ===========================================================================
# DEPLOYMENT NOTES
# ===========================================================================
# 
# 1. Database Connection:
#    - Ensure your Neo4j/CognoDB allows connections from Railway.app
#    - Check IP allowlist if using managed service
#    - Test connection locally first before deploying
#
# 2. CORS Settings:
#    - Must include your actual frontend domain
#    - Can include multiple domains separated by commas
#    - Should use HTTPS for production
#
# 3. Auto-Seeding:
#    - Set to 'true' for initial deployment to populate database
#    - After first successful seed, can set to 'false' to skip on restart
#
# 4. Security:
#    - Use strong, randomly generated passwords
#    - Never commit credentials to git
#    - Rotate passwords periodically
#    - Use environment variables only, never hardcode credentials
#
# 5. Health Checks:
#    - Railway will automatically check service health
#    - Backend: GET /api/health
#    - Frontend: GET /
#
# 6. Scaling:
#    - Default: 1 replica
#    - Can increase replicas in Railway dashboard for high traffic
#    - Ensure Neo4j connection pool can handle multiple instances
#
# ===========================================================================
