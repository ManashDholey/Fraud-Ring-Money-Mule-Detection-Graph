# CognoDB Database Configuration
# IMPORTANT: Do not commit this file to version control
# Add .env to .gitignore

COGNODB_URI=
COGNODB_USERNAME=
COGNODB_PASSWORD=

# FastAPI Configuration
API_PORT=8000

# Auto-Seeding Configuration
# Set to 'false', '0', or 'no' to disable automatic seeding on startup
# Recommended: keep 'true' for development and fresh deployments
# Only set to 'false' if you want manual control over seeding
AUTO_SEED_ON_STARTUP=true

API_HOST=0.0.0.0

# CORS Configuration
# Allow multiple localhost ports for Vite dev server (which tries sequential ports)
CORS_ORIGINS=