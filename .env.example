# Neo4j / CognoDB Configuration
# Replace with your managed Neo4j instance credentials
COGNODB_URI=bolt+s://your-neo4j-uri.com:7687
COGNODB_USERNAME=neo4j
COGNODB_PASSWORD=your_password_here

# FastAPI Configuration
# For local development (docker-compose): localhost URLs
# For production (Railway.app): use your deployed URLs
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:3000

# Frontend API Configuration
# For local development: http://localhost:8000/api
# For production: https://your-backend.railway.app/api
VITE_API_URL=http://localhost:8000/api

# Auto-seed Configuration
# Set to 'true' to automatically populate database on startup if empty
AUTO_SEED_ON_STARTUP=true

# ============================================================
# PRODUCTION CONFIGURATION (for Railway.app deployment)
# ============================================================
# When deploying to Railway.app, set these variables in the
# Railway dashboard instead of using this file:
#
# Backend Variables:
#   COGNODB_URI=bolt+s://your-host:7687
#   COGNODB_USERNAME=neo4j
#   COGNODB_PASSWORD=your_password
#   CORS_ORIGINS=https://your-frontend.railway.app
#   AUTO_SEED_ON_STARTUP=true
#
# Frontend Variables:
#   VITE_API_URL=https://your-backend.railway.app/api
#
# Railway will automatically set PORT and DATABASE_URL env vars
# ============================================================
